node_modules/
server/node_modules/
client/node_modules/
client/dist/
# Every environment file, not just the exact name `.env`. Timestamped backups
# (.env.bak-*, .env.save, .env.production) hold the same live credentials and
# were previously unignored, so a `git add -A` would have committed them.
.env
.env.*
!.env.example
env
*.local
.DS_Store

# Runtime file-stores. Anchored and enumerated rather than a bare `data/`,
# which matched at EVERY depth and so also swallowed
# server/locationPageBuilder/data/ — reference SOURCE data, not runtime state.
# The seed route requires a file from there at runtime, so a fresh clone got a
# MODULE_NOT_FOUND 500 from "Sync client list" and a test suite that died on
# import. Add a path here only when it is state the app WRITES.
/data/
server/modules/*/data/

# Robots Monitor runtime data — contains plaintext credentials, do not commit
modules/robotsMonitor/data/

# Service-account credential files (GSC Explorer, etc.) — never commit
server/secrets/

# Output of server/scripts/auditPages.js --full — regenerable, not source
server/scripts/audit-results/
