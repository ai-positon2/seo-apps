# ═══════════════════════════════════════════════════════════════════════════
# Environment template. Copy to `.env` and fill in real values.
# NEVER commit the real .env — it holds live secrets.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (server-side persistence) ──────────────────────────────────────
# Copy the project URL and server secret/service-role key from the project's
# Supabase Connect/API panels. The service-role key is server-only, bypasses
# RLS, and must never use a NEXT_PUBLIC_ or VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM / SERP providers ─────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CX=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_PSI_API_KEY=
SEMRUSH_API_KEY=
SERPER_API_KEY=

# Comp Res Beta API budget controls. These are enforced by the beta database
# reservation functions; the browser cannot increase or bypass either limit.
COMP_RES_BETA_MAX_UNITS_PER_RUN=10000
COMP_RES_BETA_MAX_UNITS_PER_DAY=100000
COMP_RES_BETA_USAGE_DAY_TIMEZONE=UTC
COMP_RES_BETA_PROVIDER_CACHE_TTL_HOURS=24
COMP_RES_BETA_RESERVATION_TTL_MINUTES=20

# ── GSC Explorer — Google Search Console service account (read-only) ────────
# Prefer the path if both are set. The service account must be added as a
# Restricted user on each target property in Search Console.
GSC_SERVICE_ACCOUNT_PATH=
GSC_SERVICE_ACCOUNT_JSON=
# GSC_FRESHNESS_DAYS=3
# GSC_MAX_HISTORY_MONTHS=16
# GSC_DAILY_CALL_CAP=2000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Auth (JWT cookie) ────────────────────────────────────────────────────────
SEO_USERNAME=
SEO_PASSWORD=
EXTENDED_USERNAME=
EXTENDED_PASSWORD=
JWT_SECRET=

# ── Auth — Sign in with Google ───────────────────────────────────────────────
# Client ID/secret from the Google Cloud Console OAuth client (Web application).
# GOOGLE_OAUTH_REDIRECT_URI must exactly match an Authorized redirect URI on
# that client, e.g. https://yourapp.com/api/auth/google/callback in production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
# Restrict who can log in — set one or both. If both are empty, any Google
# account can sign in (not recommended in production).
ALLOWED_GOOGLE_EMAILS=
ALLOWED_GOOGLE_DOMAIN=

# ── Team Insights — Google Sheets integration ────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Team Insights config (optional; defaults used if unset) ──────────────────
# WORK_WEEK_HOURS=35
# WIP_LIMIT=3
# STALE_BACKLOG_WEEKS=4
# DEFERRED_WARNING_DAYS=21
# OVER_CAPACITY_HOURS=30

# ── Jina Reader (r.jina.ai) — crawl fallback for JS-rendered / bot-walled pages ──
# Required: keyless requests get a Cloudflare 403 for every URL. Get one at https://jina.ai/reader
JINA_API_KEY=

# ── CrawlScope — hosted technical-SEO crawler + scheduled crawls ─────────────
# Needs the Supabase vars above plus supabase/migrations/0010_crawlscope.sql.
# Report workbooks are stored in a private Storage bucket created by that
# migration; override the name only if you already use "reports" for something.
# REPORT_STORAGE_BUCKET=reports
# REPORT_MAX_ATTACH_MB=15

# Report email (Resend). Without RESEND_API_KEY a scheduled crawl still runs and
# stores its workbook for download — it just emails nobody.
RESEND_API_KEY=
EMAIL_FROM=
# Used to build the run links inside the emailed report.
PUBLIC_BASE_URL=

# Where the scheduler + crawl executor run:
#   in-process (default) — inside this server, like the Robots Monitor scheduler
#   external             — you run `npm run worker --prefix server` separately
#   off                  — no scheduled crawls fire at all
# CRAWLSCOPE_WORKER=in-process

# Worker tuning (optional; defaults shown).
# WORKER_CONCURRENCY=2          # crawls executed at once
# WORKER_RUN_CONCURRENCY=4      # requests in flight within one crawl
# WORKER_PER_HOST_DELAY_MS=500  # politeness delay per host
# WORKER_POLL_MS=5000           # how often a slot looks for queued work
# SCHEDULE_TICK_MS=30000        # how often due projects are evaluated
# SCHEDULE_MAX_DUE=50           # projects fired per tick
# RUN_STALE_MS=600000           # heartbeat age before a run is reclaimed
# RUN_MAX_ATTEMPTS=2            # retries before a run is failed for good
# SCHEDULE_DEFAULT_TIMEZONE=America/Chicago
