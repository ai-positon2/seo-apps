# ═══════════════════════════════════════════════════════════════════════════
# Environment template. Copy to `.env` and fill in real values.
# NEVER commit the real .env — it holds live secrets.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (server-side persistence) ──────────────────────────────────────
# Copy the project URL and server secret/service-role key from the project's
# Supabase Connect/API panels. The service-role key is server-only, bypasses
# RLS, and must never use a NEXT_PUBLIC_ or VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM / SERP providers ─────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CX=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_PSI_API_KEY=
SEMRUSH_API_KEY=
SERPER_API_KEY=

# Comp Res Beta API budget controls. These are enforced by the beta database
# reservation functions; the browser cannot increase or bypass either limit.
COMP_RES_BETA_MAX_UNITS_PER_RUN=10000
COMP_RES_BETA_MAX_UNITS_PER_DAY=100000
COMP_RES_BETA_USAGE_DAY_TIMEZONE=UTC
COMP_RES_BETA_PROVIDER_CACHE_TTL_HOURS=24
COMP_RES_BETA_RESERVATION_TTL_MINUTES=20

# ── GSC Explorer — Google Search Console service account (read-only) ────────
# Prefer the path if both are set. The service account must be added as a
# Restricted user on each target property in Search Console.
GSC_SERVICE_ACCOUNT_PATH=
GSC_SERVICE_ACCOUNT_JSON=
# GSC_FRESHNESS_DAYS=3
# GSC_MAX_HISTORY_MONTHS=16
# GSC_DAILY_CALL_CAP=2000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Auth (JWT cookie) ────────────────────────────────────────────────────────
SEO_USERNAME=
SEO_PASSWORD=
EXTENDED_USERNAME=
EXTENDED_PASSWORD=
JWT_SECRET=

# ── Auth — Sign in with Google ───────────────────────────────────────────────
# Client ID/secret from the Google Cloud Console OAuth client (Web application).
# GOOGLE_OAUTH_REDIRECT_URI must exactly match an Authorized redirect URI on
# that client, e.g. https://yourapp.com/api/auth/google/callback in production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
# Restrict who can log in — set one or both. If both are empty, any Google
# account can sign in (not recommended in production).
ALLOWED_GOOGLE_EMAILS=
ALLOWED_GOOGLE_DOMAIN=

# ── Team Insights — Google Sheets integration ────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Team Insights config (optional; defaults used if unset) ──────────────────
# WORK_WEEK_HOURS=35
# WIP_LIMIT=3
# STALE_BACKLOG_WEEKS=4
# DEFERRED_WARNING_DAYS=21
# OVER_CAPACITY_HOURS=30

# ── Jina Reader (r.jina.ai) — crawl fallback for JS-rendered / bot-walled pages ──
# Required: keyless requests get a Cloudflare 403 for every URL. Get one at https://jina.ai/reader
JINA_API_KEY=

# ── CrawlScope — hosted technical-SEO crawler + scheduled crawls ─────────────
# Needs the Supabase vars above plus supabase/migrations/0010_crawlscope.sql.
# Report workbooks are stored in a private Storage bucket created by that
# migration; override the name only if you already use "reports" for something.
# REPORT_STORAGE_BUCKET=reports
# REPORT_MAX_ATTACH_MB=15

# Report email (Resend). Without RESEND_API_KEY a scheduled crawl still runs and
# stores its workbook for download — it just emails nobody.
RESEND_API_KEY=
EMAIL_FROM=
# Used to build the run links inside the emailed report.
PUBLIC_BASE_URL=

# Where the scheduler + crawl executor run:
#   in-process (default) — inside this server, like the Robots Monitor scheduler
#   external             — you run `npm run worker --prefix server` separately
#   off                  — no scheduled crawls fire at all
# CRAWLSCOPE_WORKER=in-process

# Auto-check PageSpeed Insights (mobile+desktop) for every eligible page right
# after each crawl completes. Off by default: PSI is slow (15-90s per URL per
# strategy) and quota-limited (see GOOGLE_PSI_API_KEY above), so turning this
# on should be a deliberate choice, not a default that silently multiplies PSI
# spend the moment this ships. Runs in the background (doesn't delay the crawl
# finishing) and is protected by a process-wide gate — only one crawl's PSI
# sample runs at a time even if several crawls finish around the same moment,
# so it can't multiply against the shared PSI quota. Pages are checked
# template-first (one per pageCategory) so a capped or interrupted sample
# still covers every page type, not just whichever template has the most
# internal links. On-demand per-page checks (the "Check PageSpeed" button in
# a run's page detail view) work regardless of this flag.
# CRAWLSCOPE_AUTO_PAGESPEED=true
#
# Caps the auto-sample instead of checking every eligible page — useful on a
# very large site where "everything" would take a long time even in the
# background. Unset means no cap.
# CRAWLSCOPE_AUTO_PAGESPEED_SAMPLE_SIZE=50

# Worker tuning (optional; defaults shown).
# WORKER_CONCURRENCY=2          # crawls executed at once
# WORKER_RUN_CONCURRENCY=4      # requests in flight within one crawl
# WORKER_PER_HOST_DELAY_MS=500  # politeness delay per host
# WORKER_POLL_MS=5000           # how often a slot looks for queued work
# SCHEDULE_TICK_MS=30000        # how often due projects are evaluated
# SCHEDULE_MAX_DUE=50           # projects fired per tick
# RUN_STALE_MS=600000           # heartbeat age before a run is reclaimed
# RUN_MAX_ATTEMPTS=2            # retries before a run is failed for good
# SCHEDULE_DEFAULT_TIMEZONE=America/Chicago

# ── AI Visibility: proxies ───────────────────────────────────────────────────
# Newline- or comma-separated. Both formats providers export are accepted:
#
#   http://user:pass@gateway.provider.com:7000#us
#   gateway.provider.com:7000:user:pass#us
#
# The `#xx` suffix is the exit country and is NOT optional for Google.
#
# Phase 0 measured that Google's hard block was a LOCALE MISMATCH, not bot
# detection: `gl=us` from a non-US IP was refused, and dropping that one
# parameter was served an AI Overview. So the proxy's job here is geographic
# honesty first and rate spreading second — an untagged proxy is never used for
# geo-pinned work, because "probably US" and "US" are not the same claim, and a
# German exit would return a German answer that we would store as a US
# measurement with nothing able to detect it.
#
# With no proxy configured, the two Google surfaces record honest `failed`
# captures (mentioned: null) rather than going out on the datacenter IP.
# Residential is required in practice; shared datacenter IPs are walled by
# Google almost immediately.
# AIV_PROXIES=
#
# AIV_PROXY_COOLDOWN_GOOGLE_MS=90000  # rest per address between Google hits
# AIV_PROXY_COOLDOWN_MS=20000         # rest for the chat engines
# AIV_PROXY_BURN_MS=1800000           # how long a walled address stays out
# AIV_PROXY_FAILURES_TO_BURN=3        # consecutive failures before ejection

# ── AI Visibility: which surfaces run ────────────────────────────────────────
# Comma-separated surface ids to turn OFF. Unset uses the default, which is the
# two DataForSEO surfaces. Set it to an empty string to turn nothing off.
#
# A turned-off surface stays REGISTERED — stored captures reference it by id and
# a report has to be able to name what produced a row it is still showing. Only
# new runs are gated.
#
# The two Google surfaces are NOT listed here: they gate themselves on
# AIV_PROXIES and rejoin the default set on their own once it is set, because
# tying them to the actual precondition is more reliable than remembering to
# flip a second switch.
#
# Today's active set: chatgpt:scraped, gemini:scraped
# AIV_DISABLED_SURFACES=chatgpt:dataforseo,google_ai_overview:dataforseo

# ── AI Visibility: capture concurrency ───────────────────────────────────────
# AIV_MAX_BROWSERS=4            # global headless Chrome cap (150-300MB each)
# AIV_GEMINI_BURST=5            # consecutive Gemini captures before a rest
# AIV_GEMINI_BURST_REST_MS=120000  # how long that rest is
# AIV_PROXY_MAX_SESSIONS=500    # sticky session entries held per pool
# AIV_RUN_DEADLINE_MS=2400000   # a run stops itself at 40min, inside the 45min allowance

# ── AI Visibility: models ────────────────────────────────────────────────────
# Both default to the values in code; set them when a model name is retired,
# so a deprecation does not need a deploy.
# AIV_EXTRACT_MODEL=claude-sonnet-5   # sentiment/negation pass over a capture
# AIV_PROMPT_MODEL=gpt-4o-mini        # writes one question per chosen page
# AIV_NUMBER_LOCALE=en-US             # thousands separators in report numbers

# ── Module run worker (queue + scheduler + reaper) ───────────────────────────
# MODULE_WORKER=in-process      # in-process | external | off
# MODULE_QUEUE_STALE_MS=600000  # heartbeat age before a run is reclaimed
# MODULE_QUEUE_MAX_ATTEMPTS=3   # claims before a run is failed for good
