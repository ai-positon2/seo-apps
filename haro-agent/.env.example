# Required for real Stage 2 scoring and pitch drafting (haro_agent.llm).
# Not needed if you run with --llm mock.
ANTHROPIC_API_KEY=

# Only needed once the Gmail mailbox adapter is wired up for production polling.
# See README.md "Connecting Gmail" section.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GMAIL_TOKEN_FILE=gmail_token.json
GMAIL_LABEL=HARO

# Only needed for --notify slack. Create via Slack: Your Workspace > Settings &
# administration > Manage apps > search "Incoming Webhooks" > Add to Slack > choose
# a channel or Direct Messages > yourself > copy the webhook URL (looks like
# https://hooks.slack.com/services/...).
SLACK_WEBHOOK_URL=

# --- Only relevant when running as the push-based webhook (see README.md
# "Production: push-based ingestion"), typically set as real Railway env vars
# rather than in this local .env file. ---

# Credentials CloudMailin's target-URL Basic Auth must present to
# POST /webhook/inbound-email. Fails closed (401) if either is unset.
WEBHOOK_AUTH_USER=
WEBHOOK_AUTH_PASS=

# Gates the dashboard (/, /reports, /state, /profiles) behind Basic Auth. Leave
# unset for open local testing; set both once this is reachable from the public
# internet, since the dashboard shows reply-to emails and draft pitches.
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASS=

# LLM_MODE=claude and NOTIFY_MODE=slack for a real deployment (both otherwise
# default to the safe/offline "mock"/"none" used for local testing).
LLM_MODE=mock
NOTIFY_MODE=none

# Where state/reports get written - point at a Railway Volume mount (e.g. /data/state,
# /data/reports) in production so history survives redeploys. Local default is fine.
STATE_DIR=
REPORTS_DIR=
