<script>


$(document).ready(function () {


    var rows = $(".idn-list tbody tr[data-idn-domain]").toArray();
    var rowCache = null;

    var searchInput = document.getElementById("idn-search");
	var clearButton = document.getElementById("idn-clear");
	var advanceFilter = document.getElementById("idn-advance-filter");
    var countElement = document.getElementById("row-count");
    var languageDropdown = document.getElementById("language-dropdown");

    if (countElement) {
        countElement.textContent = rows.length;
    }

    function normalizeForSearch(value) {
        return (value || "").toLowerCase().replace(/[_-]+/g, "");
    }

    function ensureRowCache() {
        if (rowCache) return;
        rowCache = rows.map(function (row) {
            var languageCell = row.cells[0];
            var languageValue = "";
            if (languageCell) {
                // Use explicit data-language when present; fallback to first span text.
                var explicitLanguage = languageCell.getAttribute("data-language");
                var languageTextNode = languageCell.querySelector("span");
                languageValue = (explicitLanguage || (languageTextNode && languageTextNode.textContent) || "")
                    .trim()
                    .toLowerCase();
            }
            var domainKey = ((row.dataset.idnDomain) || "").trim().toLowerCase();
            var alabelKey = ((row.dataset.idnAlabel) || "").trim().toLowerCase();
            var searchableText = (domainKey + " " + alabelKey + " " + row.textContent).toLowerCase();
            return {
                row: row,
                // Include domain key in searchable text because detail rows keep
                // the domain cell empty and the header row is not part of rowCache.
                searchText: searchableText,
                searchTextCompact: normalizeForSearch(searchableText),
                language: languageValue,
                domainKey: domainKey,
                alabelKey: alabelKey
            };
        });
    }

    function syncGroupVisibility(visibleByDomain) {
        document.querySelectorAll("#idn-table tbody tr.idn-group-row").forEach(function (groupRow) {
            var domain = (groupRow.dataset.groupDomain || "").toLowerCase();
            var shouldHide = !visibleByDomain[domain];
            if (groupRow.hidden !== shouldHide) {
                groupRow.hidden = shouldHide;
            }
        });
    }

    function closeAllDropdowns(excludeContainer) {
        document.querySelectorAll(".multiselect-container").forEach(function (container) {
            if (container !== excludeContainer) {
                container.querySelector(".options-container").classList.remove("visible");
                container.querySelector(".select-box").classList.remove("open");
            }
        });
    }

    function getSelectedLanguages() {
        if (!languageDropdown) {
            return [];
        }
        return Array.prototype.slice.call(
            languageDropdown.querySelectorAll('input[type="checkbox"]:checked')
        ).map(function (checkbox) {
            return checkbox.value.trim().toLowerCase();
        });
    }

    function updateClearButtonState(term, selectedLanguages) {
        var hasFilters = !!term || (selectedLanguages && selectedLanguages.length > 0);
        clearButton.style.display = hasFilters ? "flex" : "none";
    }

    function initializeMultiselect(container) {
        if (!container) {
            return;
        }
        var selectBox = container.querySelector(".select-box");
        var optionsContainer = container.querySelector(".options-container");
        var selectedOptionsSpan = container.querySelector(".selected-options-text");
        var checkboxes = container.querySelectorAll('input[type="checkbox"]');
        var originalPlaceholder = selectedOptionsSpan.textContent;

        container.dataset.placeholder = originalPlaceholder;

        selectBox.addEventListener("click", function (event) {
            event.stopPropagation();
            closeAllDropdowns(container);
            optionsContainer.classList.toggle("visible");
            selectBox.classList.toggle("open");
        });

        var dropdownSearchInput = container.querySelector(".multiselect-search");
        var searchTimer;
        if (dropdownSearchInput) {
            dropdownSearchInput.addEventListener("input", function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    var filter = dropdownSearchInput.value.toLowerCase();
                    container.querySelectorAll(".option").forEach(function (option) {
                        var label = option.textContent.toLowerCase();
                        option.style.display = label.includes(filter) ? "flex" : "none";
                    });
                }, 100);
            });
        }

        function updateSelectedOptions() {
            var selected = [];
            checkboxes.forEach(function (checkbox) {
                if (checkbox.checked) {
                    selected.push(checkbox.value);
                }
            });
            if (selected.length === 0) {
                selectedOptionsSpan.textContent = originalPlaceholder;
            } else if (selected.length > 2) {
                selectedOptionsSpan.textContent = selected.length + " options selected";
            } else {
                selectedOptionsSpan.textContent = selected.join(", ");
            }
        }

        checkboxes.forEach(function (checkbox) {
            checkbox.addEventListener("change", function () {
                updateSelectedOptions();
                updateTable();
            });
        });

        optionsContainer.addEventListener("click", function (event) {
            event.stopPropagation();
        });
    }

    function updateTable() {
        var term = searchInput.value.trim().toLowerCase();
        var compactTerm = normalizeForSearch(term);
        var domainOnlyMode = term.charAt(0) === ".";
        var alabelOnlyMode = term.indexOf("xn-") === 0;
        var domainTerm = domainOnlyMode ? term.slice(1).trim() : "";
        var domainCompactTerm = domainOnlyMode ? normalizeForSearch(domainTerm) : "";
        var alabelCompactTerm = alabelOnlyMode ? normalizeForSearch(term) : "";
        var selectedLanguages = getSelectedLanguages();
        var selectedLanguageSet = {};
        selectedLanguages.forEach(function (value) {
            selectedLanguageSet[value] = true;
        });
        var visibleCount = 0;
        var visibleByDomain = {};

        ensureRowCache();
        rowCache.forEach(function (record) {
            var matchesTerm;
            if (!term) {
                matchesTerm = true;
            } else if (domainOnlyMode) {
                // Dot-prefixed queries (e.g. ".com") match only domain values.
                if (!domainTerm) {
                    // Keep table visible while user has only typed ".".
                    matchesTerm = true;
                } else {
                    matchesTerm =
                        record.domainKey.startsWith(term) ||
                        record.domainKey.startsWith(domainTerm) ||
                        (domainCompactTerm && normalizeForSearch(record.domainKey).startsWith(domainCompactTerm));
                }
            } else if (alabelOnlyMode) {
                matchesTerm = !!record.alabelKey && (
                    record.alabelKey.includes(term) ||
                    (alabelCompactTerm && normalizeForSearch(record.alabelKey).includes(alabelCompactTerm))
                );
            } else {
                matchesTerm = record.searchText.includes(term) ||
                    (compactTerm && record.searchTextCompact.includes(compactTerm));
            }
            var matchesLanguage = selectedLanguages.length === 0 || !!selectedLanguageSet[record.language];
            var shouldHide = !(matchesTerm && matchesLanguage);

            if (record.row.hidden !== shouldHide) {
                record.row.hidden = shouldHide;
            }

            if (!shouldHide) {
                visibleCount++;
                visibleByDomain[record.domainKey] = true;
            }
        });


        syncGroupVisibility(visibleByDomain);

        if (countElement) {
            countElement.textContent = visibleCount;
        }
        updateClearButtonState(term, selectedLanguages);
    }

    var debounceTimer;
    searchInput.addEventListener("input", function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(updateTable, 500);
    });


    $("#idn-clear").on("click", function () {
        searchInput.value = "";
        if (languageDropdown) {
            languageDropdown.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
                checkbox.checked = false;
            });
            var placeholder = languageDropdown.dataset.placeholder;
            var selectedOptionsText = languageDropdown.querySelector(".selected-options-text");
            if (placeholder && selectedOptionsText) {
                selectedOptionsText.textContent = placeholder;
            }
        }
        updateTable();
    });

    initializeMultiselect(languageDropdown);
    window.addEventListener("click", function () {
        closeAllDropdowns();
    });

    $("#idn-toggle-filter").on("click", function () {
        var willShow = !advanceFilter.classList.contains("is-visible");
        advanceFilter.style.overflow = "";
        advanceFilter.classList.toggle("is-visible");
        document.getElementById("idn-arrow-icon").src = willShow
            ? "/static/icons/arrow-up.c18a3d1f14d3.svg"
            : "/static/icons/arrow-down.962476fb66de.svg";
        if (willShow) {
            setTimeout(function () {
                if (advanceFilter.classList.contains("is-visible")) {
                    advanceFilter.style.overflow = "visible";
                }
            }, 300);
        }
    });

    $('#idn-table tbody').on('click', 'tr[data-idn-domain]', function (e) {
    if (e.target.closest('a, button, input, label, select, textarea')) return;

    var link = this.querySelector('a[href^="/domains/idn-tables/tables/"]');
    if (!link) return;

    if (e.metaKey || e.ctrlKey) {
        window.open(link.href, '_blank');
    } else {
        window.location.href = link.href;
    }
});
    $("#nav_dom_int_sub").hide()
	$("#nav_dom_root_sub").hide()
	$("#nav_dom_dnssec_sub").hide()
	$("#nav_dom_tools_sub").hide()
	$("#nav_dom_idn").addClass("selected")
	$("#nav_dom_idn_top").addClass("selected")
	$("#nav_about_idn").addClass("selected")

    initializeSorting();
});

function initializeSorting () {
    var table = document.getElementById("idn-table");
    if (
        !table ||
        !table.tHead ||
        !table.tHead.rows.length ||
        !table.tBodies.length
    ) {
        return;
    }
    var tbody = table.tBodies[0];
    var headers = Array.prototype.slice.call(table.tHead.rows[0].cells);
    // Natural ordering: numeric-aware (so "10" sorts after "9") and
    // case-insensitive, which also gives sensible ISO-date ordering.
    var collator = new Intl.Collator(undefined, { numeric: true, sensitivity: "base" });
    var colIndex = { language: 0,  details: 1 };
    var domainGroupRows = {};
    Array.prototype.forEach.call(tbody.querySelectorAll("tr.idn-group-row"), function (row) {
        var key = (row.dataset.groupDomain || "").toLowerCase();
        if (key) {
            domainGroupRows[key] = row;
        }
    });

    var activeColumn = null;
    var  sortDirection = "asc";

    function cellText(row, index) {
        var cell = row.cells[index];

        if (!cell) {
            return "";
        }

        return cell.dataset.sortValue || cell.textContent.trim();
    }

function sortRows() {
    if (activeColumn === null) return;

    var index = colIndex[activeColumn];
    if (index === undefined) {
        return;
    }
    var direction =  sortDirection === "asc" ? 1 : -1;

    var rowsByDomain = {};
    var visibleByDomain = {};

    Array.from(tbody.querySelectorAll("tr[data-idn-domain]")).forEach(function (row) {
        var domain = (row.dataset.idnDomain || "").toLowerCase();
        if (!rowsByDomain[domain]) {
            rowsByDomain[domain] = [];
        }
        rowsByDomain[domain].push(row);
        if (!row.hidden) {
            visibleByDomain[domain] = true;
        }
    });

    Object.keys(rowsByDomain).forEach(function (domain) {
        rowsByDomain[domain].sort(function (a, b) {
            return collator.compare(cellText(a, index), cellText(b, index)) * direction;
        });
    });

    var sortedDomains = Object.keys(rowsByDomain).sort(function (domainA, domainB) {
        var rowsA = rowsByDomain[domainA];
        var rowsB = rowsByDomain[domainB];
        var keyA = rowsA.length ? cellText(rowsA[0], index) : "";
        var keyB = rowsB.length ? cellText(rowsB[0], index) : "";
        var cmp = collator.compare(keyA, keyB) * direction;
        if (cmp !== 0) {
            return cmp;
        }
        return collator.compare(domainA, domainB);
    });

    var frag = document.createDocumentFragment();
    sortedDomains.forEach(function (domain) {
        var groupRow = domainGroupRows[domain];
        if (groupRow) {
            groupRow.hidden = !visibleByDomain[domain];
            frag.appendChild(groupRow);
        }
        rowsByDomain[domain].forEach(function (row) {
            frag.appendChild(row);
        });
    });

    tbody.innerHTML = "";
    tbody.appendChild(frag);
}

    function syncHeaders() {
        headers.forEach(function (th) {
            var col = th.getAttribute("data-sort");
            if (!col) return;
            th.setAttribute("aria-sort",
                activeColumn === col ? ( sortDirection === "asc" ? "ascending" : "descending") : "none");
        });
    }
    headers.forEach(function (th) {
        if (!th.getAttribute("data-sort")) return;
        th.addEventListener("click", function () {
            var col = th.getAttribute("data-sort");
            if (activeColumn === col) {   sortDirection =  sortDirection === "asc" ? "desc" : "asc"; }
            else { activeColumn = col;  sortDirection = "asc"; }
            sortRows();
            syncHeaders();
        });
    });
}


</script>


</body>

</html>
